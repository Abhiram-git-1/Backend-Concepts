<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>roll dice</title>
</head>
<body>
    <h1>
        roll the dice and get a random number between 1 and 6 : <%= randomNumber %>
    </h1>
    <% if(randomNumber === 6){ %>
        <h3>You win! take a try again</h3>
    <% } %>
</body>
</html>

