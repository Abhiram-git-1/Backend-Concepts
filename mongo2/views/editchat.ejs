<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Chat</title>
</head>
<body>
    <h1>Edit Chat of <%= chat._id %></h1>
    <p>
        <strong>Sender:</strong> <%= chat.sender %><br>
        <strong>Receiver:</strong> <%= chat.receiver %><br>
        <strong>Message:</strong> <%= chat.message %><br>
        <strong>Timestamp:</strong> <%= new Date(chat.timestamp).toLocaleString() %><br>
    </p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
       
        <div>
            <label for="message">Message:</label>
            <textarea id="message" name="message"><%= chat.message %></textarea>
        </div>
        <button type="submit">Update Chat</button>
    </form>
</body>
</html>